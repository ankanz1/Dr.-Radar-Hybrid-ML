Dr.-Radar-Uii/node_modules/
Dr.-Radar-Uii/dist/
Dr.-Radar-Uii/.vite/
Dr.-Radar-Uii/.env
Dr.-Radar-Uii/.env.*
!Dr.-Radar-Uii/.env.example


# =========================
# Backend: ecg-qml
# =========================

ecg-qml/.venv/
ecg-qml/__pycache__/
ecg-qml/**/__pycache__/
ecg-qml/.pytest_cache/
ecg-qml/.mypy_cache/
ecg-qml/.ruff_cache/
ecg-qml/.env
ecg-qml/.env.*
!ecg-qml/.env.example

# Python compiled files
ecg-qml/**/*.pyc
ecg-qml/**/*.pyo
ecg-qml/**/*.pyd

# Logs / runtime files
ecg-qml/*.log
ecg-qml/**/*.log
ecg-qml/*.pid
ecg-qml/**/*.pid


# =========================
# ECG datasets
# =========================

