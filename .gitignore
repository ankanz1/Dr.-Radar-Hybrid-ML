ecg-qml/data/mitbih_train.csv
ecg-qml/data/mitbih_test.csv
ecg-qml/data/ptbdb_abnormal.csv
ecg-qml/data/ptbdb_normal.csv

# Also ignore datasets if accidentally placed at repo root
mitbih_train.csv
mitbih_test.csv
ptbdb_abnormal.csv
ptbdb_normal.csv


